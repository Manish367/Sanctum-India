# Local dev (in-memory MongoDB, zero setup): the defaults below are enough — just `cp .env.example .env`.
PORT=4100
USE_MEMORY_MONGO=true
MONGO_URI=mongodb://localhost:27017/sanctum-india
CLIENT_ORIGIN=http://localhost:5190

# Production (e.g. Render): set these instead —
#   USE_MEMORY_MONGO=false
#   MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/sanctum-india?retryWrites=true&w=majority
#   CLIENT_ORIGIN=https://your-frontend.vercel.app     (comma-separate to allow more than one origin)
#   PORT is provided by the host automatically; no need to set it.
